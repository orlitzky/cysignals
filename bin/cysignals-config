#!/usr/bin/env python

import sys
import cysignals._config

valid_args = [ "--cflags", "--cythonflags" ]

if len(sys.argv) != 2 or sys.argv[1] not in valid_args:
    print("Usage: cysignals-config [--cflags|--cythonflags]")
    sys.exit(1)

# Configuration must be imported so that the correct library (matching
# the running python) provides it.
if sys.argv[1] == "--cflags":
    # For example "struct_signals.h" is included without the
    # "cysignals/" prefix.
    print(f"-I{cysignals._config.includedir}/cysignals")
elif sys.argv[1] == "--cythonflags":
    # Cython doesn't support the --include-dir=<dir> form (with an
    # equal sign instead of whitespace), and meson automatically
    # quotes the output it receives, so getting the quoting right here
    # is tough. By printing the flag and its argument on separate
    # lines, we indicate which whitespace actually separates the flag
    # from its argument without having to add our own quoting (that
    # would get in meson's way).
    #
    # tl;dr use splitlines() in meson to get the array of cython_args.
    #
    print("--include-dir")
    print(cysignals._config.includedir)
